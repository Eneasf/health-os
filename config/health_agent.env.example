# Hermes Autonomous Health Intake Agent Configuration
# Copy this file to `config/health_agent.env` or set environment variables in your shell/NAS container.
# This file is gitignored and must NEVER be committed with real credentials.

# Dedicated Gemini API Key (Isolated project in Google AI Studio)
HEALTH_AGENT_GEMINI_KEY=your_gemini_api_key_here

# Vision extraction model (default: gemini-2.5-flash)
HEALTH_AGENT_MODEL=gemini-2.5-flash

# Autonomy confidence thresholds (0.0 - 1.0)
HEALTH_AGENT_EGYM_THRESHOLD=0.90
HEALTH_AGENT_INBODY_THRESHOLD=0.95
